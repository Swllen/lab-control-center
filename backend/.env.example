# Copy to .env (cp .env.example .env) and edit. All settings use the LCC_ prefix; see app/config.py.
# Admin password for the first login; if unset, a random one is written to data/.
LCC_ADMIN_PASSWORD=change-me
# Seed simulated servers/jobs on an empty database (set false to use only your real servers).
LCC_DEMO_MODE=false
# Optional: Zhipu GLM key for the terminal assistant (can also be set in Settings).
# LCC_AI_API_KEY=
