# Backend REST origin used by the Next.js proxy (server-side).
LCC_BACKEND_URL=http://127.0.0.1:8600
# Backend port the browser uses for WebSockets (host is taken from the page URL).
NEXT_PUBLIC_LCC_WS_PORT=8600
# LAN access in dev mode: extra hostnames allowed to load the dev server (comma-separated, no port).
# LCC_DEV_ORIGINS=192.168.1.20
